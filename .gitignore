# ---------- Python / Jupyter runtime artifacts ----------
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- Virtual environments ----------
.venv/
venv/
env/

# ---------- Data: commit only small, reproducible files ----------
# Full public corpus (~22 MB) is re-downloaded by src/prepare_dataset.py
data/external/
# Raw logs: only the benchmark log of the final run is tracked (~1.8 MB)
data/raw/*
!data/raw/test_run.jsonl
# Processed data: only aggregated summaries are tracked
data/processed/*
!data/processed/metrics_summary.csv
!data/processed/latency_summary.csv

# ---------- Experiment outputs (Task 2 smoke test) ----------
outputs/

# ---------- Model binaries and heavy dumps ----------
*.pkl
*.joblib
*.onnx
*.bin
*.pt
*.pth
*.h5
*.parquet
*.zip
*.tar.gz

# ---------- Misc ----------
*.log
*.tmp
.env
*.key
*.pem
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local review files and temporary extracted archives
/task3_current_files/
/task3_full_results/
/task3_results_update/
/task3_revision_update/
/APPLY_RESULTS_RU.txt
/START_HERE_RU.txt
/requirements-review.txt
/data/review_smoke/
/data/review_validation/

# Keep completed experiment evidence, excluding oversized plain logs
/data/review_runs/**/raw.jsonl
/data/review_runs/**/figures/
/data/review_runs/**/processed/

# Current aggregated results
!data/processed/quality_repeats.csv
!data/processed/quality_summary.csv
!data/processed/latency_repeats.csv
!data/processed/rps_summary.csv
!data/processed/guardrails.csv
!data/processed/paired_feature_effects.csv
!data/processed/INTERPRETATION.txt

# Organized current and historical evidence
/task3_cleanup_update/
!data/review_runs/**/raw.jsonl.gz
!archive/task3_batch/data/raw/test_run.jsonl
!archive/task3_batch/data/processed/metrics_summary.csv
!archive/task3_batch/data/processed/latency_summary.csv

# Final submission package and local plot backups
/task3_final_update/
/outputs/
